# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration (opcional - agregar cuando se configure)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# MercadoPago Configuration
MP_ACCESS_TOKEN=your_mp_access_token
NEXT_PUBLIC_MP_PUBLIC_KEY=your_mp_public_key

# PayPal Configuration
# Obtén credenciales en: https://developer.paypal.com → Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_ENV=sandbox             # "sandbox" o "production"
NEXT_PUBLIC_PAYPAL_CURRENCY=USD  # "USD" (global) o "PEN" (cuenta PayPal en Perú)
PAYPAL_CURRENCY=USD
# PAYPAL_EXCHANGE_RATE=0.27      # Solo si PAYPAL_CURRENCY=USD, convierte PEN→USD

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
